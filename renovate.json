{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": true,
  "extends": [
    "github>moritzbrantner/coding-agent-conventions"
  ],
  "packageRules": [
    {
      "description": "3d-lab crates share types (three-d-core) and must move to the same commit together",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "three-d-*"
      ],
      "groupName": "3d-lab"
    },
    {
      "description": "Crates from one git repository must move together; single-crate digest bumps split the graph across revisions.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "git-pinned crate revisions"
    }
  ]
}
